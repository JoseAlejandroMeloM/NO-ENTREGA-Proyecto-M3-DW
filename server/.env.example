# Copy to server/.env for local development. Never commit the real .env.
NODE_ENV=development
PORT=4000
# MongoDB Atlas connection string (Database > Connect > Drivers). Add the database name after .mongodb.net/
# (the deployments use /conecta-negocio); without it Atlas uses the database "test".
# Must be a replica set (Atlas always is): sales use transactions. A standalone local mongod will not work.
MONGODB_URI=
# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=conecta-negocio-auth
JWT_AUDIENCE=conecta-negocio-api
# Only needed when the client runs on a different origin (comma-separated)
CORS_ORIGIN=http://localhost:5173
